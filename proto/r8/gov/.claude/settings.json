{
  "permissions": {
    "allow": ["Bash", "Edit", "Write", "Read"],
    "deny": ["Bash(git push origin main:*)", "Bash(git push origin master:*)", "Read(.env)", "Read(.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/crewboss-gate.sh" } ] }
    ]
  }
}
