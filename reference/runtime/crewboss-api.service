# Example system service. Create a dedicated crewboss account with home
# /var/lib/crewboss and install the runtime in /var/lib/crewboss/cbnet.
# CB_HOME and CB_ENV_FILE can be overridden together for other installations.
# Use render-units.py to render all services for a different service account.
#
# Copy api.env.example to /var/lib/crewboss/.crewboss.env, set CB_REPO and a private
# CB_API_TOKEN, and restrict its permissions. The EnvironmentFile is mandatory.
# Authenticate gh for the service account or supply GH_TOKEN in that file.
# Bind to loopback by default; configure an authenticated reverse proxy / tunnel
# for remote access. Webhooks additionally require CB_WEBHOOK_SECRET.

[Unit]
Description=crewboss dashboard API (board state and dashboard static files)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crewboss
Group=crewboss
WorkingDirectory=/var/lib/crewboss/cbnet
Environment=HOME=/var/lib/crewboss
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=CB_HOME=/var/lib/crewboss/cbnet
Environment=CB_API_HOST=127.0.0.1
# systemd loads the same configuration that run-env.sh reads for API Run actions.
# Entrypoints re-read the same trusted file before launching work.
Environment=CB_ENV_FILE=/var/lib/crewboss/.crewboss.env
EnvironmentFile=/var/lib/crewboss/.crewboss.env
ExecStart=/bin/bash /var/lib/crewboss/cbnet/start-api.sh --foreground
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
