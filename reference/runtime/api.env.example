# Copy to the service account's ~/.crewboss.env, or choose an absolute CB_ENV_FILE.
# The default systemd templates use /var/lib/crewboss/.crewboss.env. API and launcher
# share the same file; assignments in it override inherited environment values.
# Keep the real file private (chmod 600) and out of version control.
# This format is shared by bash and systemd: use literal KEY=value assignments,
# no `export`, command substitutions, $VARIABLE references, or ~ expansion.

# Required: choose your repository and generate a private token, for example
# by running `openssl rand -hex 32` locally and pasting the result here.
CB_REPO=
CB_API_TOKEN=

# Runtime directory; defaults to $HOME/cbnet when omitted. Other absolute paths
# are supported. Set the same path in rendered units and make it writable.
CB_HOME=/var/lib/crewboss/cbnet
CB_API_HOST=127.0.0.1
CB_API_PORT=8787

# Optional manifest mode: explicitly opt in after reviewing the team's workflow.
# Use literal absolute paths matching your CB_HOME; keep both settings aligned.
# The example leaves this mode disabled. Linux sandbox integration does not
# validate the manifest workflow. CB_TEAM alone selects the dashboard Team data;
# saving it neither enables manifest mode nor synchronizes gov/.claude/agents.
# Without CB_MANIFEST, agent preparation uses those separate governance agents.
# CB_MANIFEST=/var/lib/crewboss/cbnet/team
# CB_TEAM=/var/lib/crewboss/cbnet/team

# Optional: comma-separated exact browser origins. Defaults allow localhost,
# 127.0.0.1 and [::1] at UI port 5500 and the configured API port. An explicit
# empty value disables browser cross-origin requests.
# CB_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: defaults to CB_HOME/crewboss-api.py. For a source checkout, use the
# absolute path to ui/server/crewboss-api.py instead.
# CB_API_SCRIPT=/absolute/path/to/crewboss/ui/server/crewboss-api.py

# Optional: built dashboard assets and GitHub webhook HMAC secret.
# The alpha archive installs its static dashboard in CB_HOME/ui.
# CB_WEB_DIR=/var/lib/crewboss/cbnet/ui
# CB_WEBHOOK_SECRET=

# Required for agent operations: an explicit GitHub credential. Startup never
# extracts a stored login token; doctor fails before mutations if it is missing.
GH_TOKEN=

# Supply the credentials required by your agent provider in this shared file so
# API Run actions can pass them to the launcher. For Claude OAuth, for example:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Agent runtime: Linux x86_64 and Bash 5+, with nsjail, flock, jq, git, gh,
# python3 and perl. The existing x86_64 seccomp policy is not portable to ARM64.
# Provider paths default to the service account HOME. The read-only installation
# directory must contain the resolved executable (including symlink targets).
# CB_AGENT_HOME=/var/lib/crewboss
# CB_CLAUDE_BIN=/var/lib/crewboss/.local/bin/claude
# CB_CLAUDE_INSTALL_DIR=/var/lib/crewboss/.local
# CB_CLAUDE_CONFIG_DIR=/var/lib/crewboss/.claude
# CB_CLAUDE_CONFIG_FILE=/var/lib/crewboss/.claude.json
# CB_NSJAIL_BIN=/usr/local/bin/nsjail
# CB_GH_BIN=/usr/bin/gh
