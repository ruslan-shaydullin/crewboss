# Default unprivileged launcher service. Render with render-units.py for another
# user/home/runtime directory. run-charter.sh loads run-env.sh and runs doctor
# before labels or agent work, then execs crewboss-launcher-gh.sh in this cgroup.
[Unit]
Description=crewboss launcher loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crewboss
Group=crewboss
WorkingDirectory=/var/lib/crewboss/cbnet
Environment=HOME=/var/lib/crewboss
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=CB_HOME=/var/lib/crewboss/cbnet
Environment=CB_ENV_FILE=/var/lib/crewboss/.crewboss.env
EnvironmentFile=/var/lib/crewboss/.crewboss.env
ExecStart=/bin/bash /var/lib/crewboss/cbnet/run-charter.sh --foreground
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
