# Idempotent restart request. Only this fixed systemctl command runs as root;
# user-writable runtime scripts execute in crewboss-launcher.service as its User.
# The launcher lives in its own cgroup and survives this oneshot's completion.
[Unit]
Description=crewboss launcher keepalive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl start crewboss-launcher.service
