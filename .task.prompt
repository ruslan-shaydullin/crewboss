- check: N=$(curl -s -H "Authorization: Bearer $CB_API_TOKEN" http://localhost:8787/api/state | jq -r '[.board[] | select(.kind=="leaf")] | .[0].n') && curl -s -H "Authorization: Bearer $CB_API_TOKEN" http://localhost:8787/api/comments/$N | jq -e '.comments | length > 0'