- check: grep -q "by_n.setdefault" ui/server/crewboss-api.py
- check: grep -qv "return _cached_issues" ui/server/crewboss-api.py
- check: grep -q "ALLOW board-charter-visibility" reference/runtime/per-leaf-manifest
